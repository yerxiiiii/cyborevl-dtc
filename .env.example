# 复制为 .env 后填写，再用 `node --env-file=.env server.js` 启动

# 公开服务端口（表单页 + 提交接口）
PORT=3000

# 后台服务端口（admin.html + 数据读取接口）
ADMIN_PORT=3001

# 允许访问后台的 IP（公司办公室出口 IP，多个用逗号分隔）
# 查询办公室出口 IP：在办公室网络下打开 https://ifconfig.me
ADMIN_ALLOWED_IPS=

# 位于 nginx / 负载均衡后面时设置，才能从 X-Forwarded-For 读到真实客户端 IP
# （限流与后台 IP 白名单都依赖它）
# 单个 nginx 前置 → 填 1（按 1 跳代理解析，最安全，防客户端伪造 XFF）
# 多层代理 → 填对应跳数；不确定可填 true（信任全部，较宽松）
TRUST_PROXY=

# 提交接口限流：每个 IP 在 RATE_LIMIT_WINDOW_MS 毫秒内最多 RATE_LIMIT_MAX 次
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MS=60000

# 本地开发跳过 IP 白名单（⚠️ 生产环境务必不要设置此项）
# ADMIN_PUBLIC=1

# ---- Meta Conversions API（服务端 Lead，可选）----
# 不填 META_CAPI_TOKEN 时不发送服务端事件，行为与现在一致
# Pixel/数据源 ID（默认与前端一致，一般不用改）
META_PIXEL_ID=994085383416135
# 访问令牌：Events Manager → 数据源 → 设置 → Conversions API → 生成访问令牌
META_CAPI_TOKEN=
# 联调用测试码：Events Manager → Test Events 标签里的 TEST***；正式上线留空
META_TEST_EVENT_CODE=
# Graph API 版本（一般不用改）
META_API_VERSION=v21.0

# ---- TikTok Events API（服务端 SubmitForm，可选）----
# 不填 TIKTOK_ACCESS_TOKEN 时不发送服务端事件，行为与现在一致
# Pixel/数据源 ID（默认与前端一致，一般不用改）
TIKTOK_PIXEL_ID=D93MPDRC77UARCKAUGE0
# 访问令牌：TikTok Events Manager → 数据源 → 设置 → Events API → 生成 Access Token
TIKTOK_ACCESS_TOKEN=
# 联调用测试码：Events Manager 的 Test Event Code；正式上线留空
TIKTOK_TEST_EVENT_CODE=
